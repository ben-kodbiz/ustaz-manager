{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ustaz configuration",
  "type": "object",
  "required": ["id", "identity", "sources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "identity": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "youtube_channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "youtube_playlists": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "any_array_present": ["youtube_channels", "youtube_playlists"]
    },
    "content": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "default_category": { "type": "string" },
        "speaker_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "rules": { "type": "object" },
        "match_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match", "category"],
            "properties": {
              "match": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              },
              "category": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "persona": {
      "type": "object",
      "properties": {
        "display_name": { "type": "string" },
        "short_description": { "type": "string" },
        "intro_text": { "type": "string" },
        "preferred_categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "site_style": { "type": "string" }
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" }
      }
    },
    "download": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["metadata", "audio", "video"] }
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "manual"]
        }
      }
    }
  }
}
